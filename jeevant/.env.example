# ─────────────────────────────────────────────────────────────
# JEEVANT OS — environment template
# Copy to .env.local and fill in what you have. Everything is optional
# except MONGODB_URI and ADMIN_SECRET; missing pieces degrade to safe
# local fallbacks instead of breaking.
# ─────────────────────────────────────────────────────────────

# Core
MONGODB_URI=mongodb://localhost:27017/jeevant
ADMIN_SECRET=change-me
# Sessions are signed with ADMIN_SECRET (see lib/auth.ts).

# Groq — free tier. Used for speech-to-text AND as the default chat/agent model.
# Free quota is per key. Put several keys here, comma-separated, to multiply it:
# the client rotates to the next key on 429/401/403/5xx. A single key still works.
GROQ_API_KEYS=
# Backwards-compatible single key; appended to the pool if GROQ_API_KEYS is set.
GROQ_API_KEY=
GROQ_WHISPER_MODEL=whisper-large-v3
# Qwen on Groq for content and coding.
GROQ_MODEL=qwen/qwen3.8-27b
# The agent planner needs reliable JSON/tool calls; gpt-oss is better at that.
AGENT_MODEL=openai/gpt-oss-120b
# Coding edits use Qwen by default; override if needed.
CODING_MODEL=qwen/qwen3.8-27b
# If the requested model fails, try this one before giving up.
GROQ_FALLBACK_MODEL=openai/gpt-oss-120b

# AI drafting (Gemini — free tier; comma-separated pool rotates on 429)
GEMINI_API_KEYS=
GEMINI_MODEL=gemini-2.0-flash

# Google: Gmail drafts + Calendar (one OAuth app covers both)
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REFRESH_TOKEN=
GMAIL_SENDER=
GOOGLE_CALENDAR_ID=primary
# Timezone used for availability search
GOOGLE_TIMEZONE=Asia/Kolkata

# Distribution
# n8n webhook — optional, unlocks full automation for every platform.
# Also used as the free fallback for WhatsApp/SMS messages when no paid provider
# is configured. Payload: { type: "message", channel, to, body }.
N8N_WEBHOOK_URL=
# Telegram direct posting (free Bot API)
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=
# WhatsApp share-link default (country code, digits only)
WHATSAPP_DEFAULT_NUMBER=
# Public site URL used in share links
PUBLIC_SITE_URL=https://jeevant.is-a.dev

# Social posting endpoints (optional, free)
DISCORD_WEBHOOK_URL=
# Additional Discord channels, comma-separated. A post fans out to all of them.
DISCORD_WEBHOOK_URLS=
SLACK_WEBHOOK_URL=
MASTODON_INSTANCE=
MASTODON_TOKEN=
TWITTER_BEARER_TOKEN=

# Retention — Mongo TTL indexes (days)
RETENTION_CHAT_DAYS=90
RETENTION_AUDIT_DAYS=180
RETENTION_OUTBOUND_DAYS=180

# Mobile app CORS allowlist (comma-separated). The defaults already include
# https://jeevant.is-a.dev, localhost:5173/4173, and Capacitor origins.
MOBILE_ORIGINS=

# Phone coding sandbox. Only these repos are accepted; the client can never send
# an arbitrary path. Format: key=/absolute/path/to/repo|owner/repo|test command
CODING_REPOS=
# Fallback test command when a repo does not declare one (blank = skip tests).
CODING_TEST_CMD=
# Base branch for pull requests.
CODING_BASE_BRANCH=main
# Optional: push the approved branch and open a PR. Without it, approval keeps
# the diff but creates no PR.
GITHUB_TOKEN=
# Temp clone root (defaults to /tmp/opencode/jv-coding).
CODING_TMP_DIR=

# Rate limiting: "mongo" (default, distributed) or "memory" (single instance)
RATE_LIMIT_STORE=mongo

# Web Push (VAPID) — generate with: npx web-push generate-vapid-keys
# HTTPS is required in production; localhost works for development.
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=mailto:you@example.com

# Messaging (optional)
# WhatsApp Cloud API — requires a Meta business app and phone number
WHATSAPP_TOKEN=
WHATSAPP_PHONE_NUMBER_ID=
WHATSAPP_API_VERSION=v20.0
# Twilio — SMS and calls (paid; leave blank to use manual/link fallbacks)
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_FROM_NUMBER=

# Guardrails
# There is deliberately NO auto-send variable. Every outbound action is queued
# in /approvals, or blocked entirely from /guardrails (emergency stop).
# HTTP hosts for workflow steps must be allowlisted on /guardrails.

# Cron
# Required in production. Send Authorization: Bearer CRON_SECRET (or x-cron-secret).
# Query-string secrets are not accepted. Missing secret = 503 in production.
CRON_SECRET=
